# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Data — not tracked; see data/raw/README.md for sources
data/raw/
data/preprocessed/
!data/raw/README.md
!data/preprocessed/.gitkeep

# Results — regenerated by pipeline
results/models/
results/figures/
results/tables/
results/hardware/
!results/**/.gitkeep

# IBM Quantum credentials — never commit
~/.qiskit/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Checkpoints / large binaries
*.pt
*.pth
*.onnx
